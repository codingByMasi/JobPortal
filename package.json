{
  "name": "jobs-abroad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/checkConfig.mjs && vite build && node scripts/headers.mjs && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "node scripts/schema.mjs",
