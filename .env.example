# Copy this file to .env and fill in the two values from Supabase: Project Settings > API.
# Leave them empty on your computer to run in demo mode (sample data saved only in your browser).
# A PUBLISHED site with no keys shows a "not ready" page, never fake data. For a public demo site on purpose, also set:
# VITE_ALLOW_DEMO=true
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
